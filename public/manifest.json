      "label": "KLA-MEET - Make Friends in Kampala"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "KLA-MEET Mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Find Friends Near You",
      "short_name": "Nearby",
      "description": "Find friends in Kampala",
      "url": "/?action=nearby",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Chat with Friends",
      "short_name": "Chat",
      "description": "Open your chats",
      "url": "/?action=chat",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Make New Friends",
      "short_name": "Discover",
      "description": "Discover new people",
      "url": "/?action=discover",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
