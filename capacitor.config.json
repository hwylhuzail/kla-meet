{
  "appId": "com.klameet.app",
  "appName": "KLA-MEET",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "plugins": {
    "Geolocation": {
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "Camera": {
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}