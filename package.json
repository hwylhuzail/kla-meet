{
  "name": "kla-meet",
  "private": false,
  "version": "4.0.1",
  "description": "KLA-MEET - Uganda Friendship Social Network for adults 18+ to make new friends in Kampala, Entebbe, Wakiso, Jinja, Mbarara. Safe chat, nearby friends, private messaging.",
  "author": "KLA-MEET Uganda <kla.meet.ug@gmail.com>",
  "license": "MIT",
  "keywords": ["uganda", "social network", "friends", "kampala", "chat", "uganda app"],
  "homepage": "https://kla-meet.vercel.app",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/generate-icons.mjs",
    "dev": "vite",
    "build": "vite build",
    "cap:init": "npx cap init KLA-MEET com.klameet.app --web-dir=dist",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:build": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@supabase/supabase-js": "^2.45.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.8",
    "tailwindcss": "^3.4.10",
    "postcss": "^8.4.40",
    "autoprefixer": "^10.4.20"
  }
}